# kurulum tarafından yönetilir (nginx, native modu). Dağıtımın varsayılan sitesi (sites-enabled/default bağı) devre dışı bırakılır; sites-available/default silinmez.
server {
    listen {{ k_bind }}:{{ k_port }} default_server;
    server_name _;
    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;
    location / {
        try_files $uri $uri/ =404;
    }
}
