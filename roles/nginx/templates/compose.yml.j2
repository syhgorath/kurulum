# kurulum tarafından üretildi (nginx, docker modu). Elle düzenlenirse sonraki kur/yukselt bu dosyayı yeniden yazar.
services:
  nginx:
    image: {{ k_imaj }}
    container_name: kurulum-nginx
    restart: unless-stopped
    ports:
      - "{{ k_bind }}:{{ k_port }}:80"
    volumes:
      - ./data/www:/usr/share/nginx/html:ro
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'exec 3<>/dev/tcp/127.0.0.1/80 && printf \"GET / HTTP/1.0\\r\\n\\r\\n\" >&3 && head -n1 <&3 | grep -q 200'"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 5s
networks:
  default:
    name: {{ kurulum_docker_ag }}
    external: true
